# Copy this file to .env and set these values in your shell or deployment environment.
# Do not commit the real .env file.
DB_NAME=pharmacy_db
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
# Add the public hostname used by the deployment, without http:// or a path.
ALLOWED_HOSTS=your-pharmacy-domain.example,www.your-pharmacy-domain.example
